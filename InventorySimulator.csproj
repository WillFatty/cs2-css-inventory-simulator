<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Build straight into a folder that mirrors the server's addon layout. -->
    <OutputPath>addons\counterstrikesharp\plugins\InventorySimulator\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.379" />
    <LangFiles Include="source\InventorySimulator\lang\**\*.*" />
    <ProjectReference Include="D:\Code\HexiumCS-UI\HexiumCS-UI\HexiumCS-UI.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <Copy SourceFiles="@(LangFiles)" DestinationFolder="$(OutputPath)\lang" />
    <Copy
      SourceFiles="gamedata\inventory-simulator.json"
      DestinationFolder="$(OutputPath)\..\..\gamedata"
    />
  </Target>
</Project>
